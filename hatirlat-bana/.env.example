# npm run vapid ile otomatik üretilir (.env.local)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push servislerinin (Apple/Google) sana ulaşabileceği adres
VAPID_SUBJECT=mailto:sen@ornek.com

# Tekrarlayan hatırlatmaların hesaplandığı saat dilimi
APP_TIMEZONE=Europe/Istanbul

# Push abonelikleri ve zamanlanmış hatırlatmaların tutulduğu klasör
# DATA_DIR=.data

# Sadece harici cron kullanıyorsan (serverless): GET /api/cron için gizli anahtar
# CRON_SECRET=
# DISABLE_INTERNAL_SCHEDULER=1
